    "/admin/mcp-service-tokens/": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "_id",
            "schema": {
              "properties": {
                "$in": {
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
              },
              "type": "object",
            },
          },
          {
            "in": "query",
            "name": "q",
            "schema": {
              "oneOf": [
                null,
                {
                  "properties": {
                    "$in": {
                      "items": {},
                      "type": "array",
                    },
                  },
                  "type": "object",
                },
              ],
            },
          },
          {
            "in": "query",
            "name": "name",
            "schema": {
              "oneOf": [
                {
                  "description": "User-provided label identifying the MCP service token",
                  "type": "string",
                },
                {
                  "properties": {
                    "$in": {
                      "items": {
                        "type": "string",
                      },
                      "type": "array",
                    },
                  },
                  "type": "object",
                },
              ],
            },
          },
          {
            "in": "query",
            "name": "tokenPrefix",
            "schema": {
              "oneOf": [
                {
                  "description": "First eight characters after mcp_ used to identify the token safely",
                  "type": "string",
                },
                {
                  "properties": {
                    "$in": {
                      "items": {
                        "type": "string",
                      },
                      "type": "array",
                    },
                  },
                  "type": "object",
                },
              ],
            },
          },
          {
            "in": "query",
            "name": "userId",
            "schema": {
              "oneOf": [
                {
                  "description": "The user this MCP service token acts as",
                  "type": "schemaobjectid",
                },
                {
                  "properties": {
                    "$in": {
                      "items": {
                        "type": "schemaobjectid",
                      },
                      "type": "array",
                    },
                  },
                  "type": "object",
                },
              ],
            },
          },
          {
            "in": "query",
            "name": "lastUsedAt",
            "schema": {
              "oneOf": [
                {
                  "description": "When this MCP service token most recently authenticated an MCP request",
                  "format": "date-time",
                  "type": "string",
                },
                {
                  "properties": {
                    "$gt": {
                      "description": "When this MCP service token most recently authenticated an MCP request",
                      "format": "date-time",
                      "type": "string",
                    },
                    "$gte": {
                      "description": "When this MCP service token most recently authenticated an MCP request",
                      "format": "date-time",
                      "type": "string",
                    },
                    "$lt": {
                      "description": "When this MCP service token most recently authenticated an MCP request",
                      "format": "date-time",
                      "type": "string",
                    },
                    "$lte": {
                      "description": "When this MCP service token most recently authenticated an MCP request",
                      "format": "date-time",
                      "type": "string",
                    },
                  },
                  "type": "object",
                },
              ],
            },
          },
          {
            "in": "query",
            "name": "expiresAt",
            "schema": {
              "oneOf": [
                {
                  "description": "When this MCP service token expires; unset when it does not expire",
                  "format": "date-time",
                  "type": "string",
                },
                {
                  "properties": {
                    "$gt": {
                      "description": "When this MCP service token expires; unset when it does not expire",
                      "format": "date-time",
                      "type": "string",
                    },
                    "$gte": {
                      "description": "When this MCP service token expires; unset when it does not expire",
                      "format": "date-time",
                      "type": "string",
                    },
                    "$lt": {
                      "description": "When this MCP service token expires; unset when it does not expire",
                      "format": "date-time",
                      "type": "string",
                    },
                    "$lte": {
                      "description": "When this MCP service token expires; unset when it does not expire",
                      "format": "date-time",
                      "type": "string",
                    },
                  },
                  "type": "object",
                },
              ],
            },
          },
          {
            "in": "query",
            "name": "revokedAt",
            "schema": {
              "oneOf": [
