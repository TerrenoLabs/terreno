                      },
                      "type": "array",
                    },
                  },
                  "type": "object",
                },
              ],
            },
          },
          {
            "in": "query",
            "name": "type",
            "schema": {
              "oneOf": [
                {
                  "default": "boolean",
                  "description": "Boolean toggle or multi-variant A/B test",
                  "enum": [
                    "boolean",
                    "variant",
                  ],
                  "type": "string",
                },
                {
                  "properties": {
                    "$in": {
                      "items": {
