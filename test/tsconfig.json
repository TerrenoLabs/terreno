{
  "compilerOptions": {
    "declaration": true,
    "isolatedModules": true,
    "lib": ["es2023"],
    "module": "nodenext",
    "noImplicitAny": false,
    "noImplicitReturns": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "skipLibCheck": true,
    "strict": true,
    "target": "es2023",
    "types": ["bun", "node"]
  },
  "exclude": ["node_modules", "**/*.test.ts", "src/mongo/ensureMongoBinary.ts"],
  "include": ["src"]
}
