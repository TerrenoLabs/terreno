                      "type": "string",
                    },
                    "$gte": {
                      "description": "When this document was created",
                      "format": "date-time",
                      "type": "string",
                    },
                    "$lt": {
                      "description": "When this document was created",
                      "format": "date-time",
                      "type": "string",
                    },
