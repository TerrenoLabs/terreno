{
  "author": "Josh Gachnang",
  "bin": {
    "terreno": "./dist/bin.js"
  },
  "bugs": {
    "url": "https://github.com/TerrenoLabs/terreno/issues"
  },
  "dependencies": {
    "@terreno/mcp": "workspace:*",
    "@terreno/syncdb": "workspace:*",
    "create-terreno-app": "workspace:*"
  },
  "description": "Terreno CLI for docs, codegen, app scaffolding, and OpenAPI-driven REST clients",
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "exports": {
    ".": {
      "bun": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./rest": {
      "bun": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "LICENSE",
    "dist"
  ],
  "homepage": "https://github.com/TerrenoLabs/terreno#readme",
  "keywords": [
    "terreno",
    "cli",
    "openapi",
    "codegen"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "name": "@terreno/cli",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/TerrenoLabs/terreno.git"
  },
  "scripts": {
    "compile": "bun tsc",
    "compile:watch": "bun tsc -w",
    "dev": "bun tsc -w",
    "lint": "biome check ./src",
    "lint:fix": "biome check --write ./src",
    "test": "bun test src/",
    "test:agent": "AGENT=1 bun test --only-failures src/",
    "test:ci": "bun test src/",
    "test:coverage": "bun run ../scripts/check-coverage.ts"
  },
  "types": "dist/index.d.ts",
  "version": "57.3.0"
}
