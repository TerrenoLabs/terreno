{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    // @docusaurus/tsconfig sets the deprecated baseUrl; null clears it so paths resolve from here.
    "baseUrl": null,
    "paths": {
      "@site/*": ["./*"]
    }
  },
  "include": ["src/**/*", "scripts/**/*", "docusaurus.config.ts", "sidebars.ts"],
  "exclude": ["scripts/**/*.test.ts"]
}
