{
  // No isolatedModules: TinyBase declares `Persists` as an ambient const enum, which tsc inlines.
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "jsx": "react-jsx",
    "lib": ["dom", "es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "es2022",
    "types": ["bun", "node"]
  },
  "exclude": ["node_modules", "dist"],
  "include": ["src"]
}
