{
  "author": "Josh Gachnang",
  "bugs": {
    "url": "https://github.com/TerrenoLabs/terreno/issues"
  },
  "dependencies": {
    "@openfeature/server-sdk": "catalog:",
    "@terreno/api": "workspace:*",
    "express": "catalog:",
    "lodash": "catalog:"
  },
  "description": "Feature flags and A/B testing plugin for @terreno/api — part of Terreno, the batteries-included TypeScript framework for universal apps.",
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@terreno/test": "workspace:*",
    "@types/bun": "catalog:",
    "@types/express": "catalog:",
    "@types/lodash": "catalog:",
    "@types/luxon": "catalog:",
    "@types/supertest": "catalog:",
    "luxon": "catalog:",
    "mongoose": "catalog:",
    "passport-local-mongoose": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:"
  },
  "homepage": "https://github.com/TerrenoLabs/terreno#readme",
  "keywords": [
    "feature-flags",
    "ab-testing",
    "api",
    "express",
    "terreno"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "name": "@terreno/feature-flags",
  "peerDependencies": {
    "mongoose": "^8.0.0 || ^9.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/TerrenoLabs/terreno.git"
  },
  "scripts": {
    "compile": "bun tsc",
    "compile:watch": "bun tsc -w",
    "dev": "bun tsc -w",
    "lint": "biome check ./src ./e2e",
    "lint:fix": "biome check --write ./src ./e2e",
    "smoke": "bun e2e/smoke.ts",
    "test": "bun ../scripts/test-shards.ts",
    "test:agent": "AGENT=1 bun ../scripts/test-shards.ts -- --only-failures",
    "test:ci": "bun ../scripts/test-shards.ts",
    "test:coverage": "bun run ../scripts/check-coverage.ts",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "types": "dist/index.d.ts",
  "version": "58.0.6"
}
