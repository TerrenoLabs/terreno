            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "type": "array",
                    },
                    "limit": {
                      "type": "number",
                    },
                    "more": {
                      "type": "boolean",
                    },
                    "page": {
                      "type": "number",
                    },
                    "total": {
                      "type": "number",
                    },
                  },
                  "type": "object",
                },
              },
            },
            "description": "Success",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError",
                },
              },
            },
            "description": "Bad request",
          },
          "401": {
            "description": "The user must be authenticated",
          },
          "403": {
            "content": {
              "application/json": {
