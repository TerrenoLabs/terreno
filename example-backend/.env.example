# Example backend environment variables
# Copy to .env and adjust for local development.

# Server
PORT=4000

# MongoDB (replica set required for realtime/sync change streams)
MONGO_URI=mongodb://127.0.0.1:27017/terreno-example?replicaSet=rs0

# Authentication (Better Auth is the default for the example app)
AUTH_PROVIDER=better-auth
BETTER_AUTH_SECRET=terreno-example-better-auth-secret-dev-only-32
BETTER_AUTH_URL=http://localhost:4000

# Bearer token for POST /announcements/import-release. Same default Terraform seeds
# on the example Cloud Run service.
ANNOUNCEMENTS_UPLOAD_TOKEN=terreno-example-announcement-upload

# Legacy JWT secrets (still required for RealtimeApp socket JWT fallback)
TOKEN_SECRET=dev-token-secret
TOKEN_ISSUER=terreno-dev
REFRESH_TOKEN_SECRET=dev-refresh-secret
SESSION_SECRET=dev-session-secret

# Optional — Swagger UI at /swagger
# ENABLE_SWAGGER=true

# Optional — GCS uploads (admin document storage)
# GCS_BUCKET=your-uploads-bucket

# AI Provider - Vertex AI (uses Application Default Credentials)
# GOOGLE_VERTEX_PROJECT=your-gcp-project-id
# GOOGLE_VERTEX_LOCATION=us-central1
# GOOGLE_VERTEX_ALLOWED_MODELS=gemini-2.5-flash,gemini-2.5-pro

# Extra web origins allowed for credentialed CORS (comma-separated). The dev frontend
# origin http://localhost:8082 is allowed by default; set this to your hosted frontend
# origin(s) in deployed environments (Better Auth uses credentialed cross-origin requests).
# CORS_ORIGINS=https://your-frontend.example.com

# Background jobs — API process starts the Mongo worker by default. Set false when you run
# the dedicated worker entry (`bun run jobs:worker`) so only one poll loop claims jobs.
# JOBS_START_WORKER=true

# Optional — dispatch durable jobs through GCP Cloud Tasks. Cloud Tasks pushes to a
# private Cloud Run service; it is not consumed by the standalone Mongo worker.
# JOBS_RUNNER=gcp-cloud-tasks
# JOBS_START_WORKER=false
# GCP_TASKS_PROJECT=your-gcp-project-id
# GCP_TASKS_LOCATION=us-central1
# GCP_TASKS_QUEUE=terreno-example-jobs
# GCP_TASKS_PUBLIC_URL=https://your-jobs-worker.example.com
# GCP_TASKS_OIDC_AUDIENCE=https://your-jobs-worker.example.com
# GCP_TASKS_SERVICE_ACCOUNT_EMAIL=terreno-jobs-invoker@your-gcp-project-id.iam.gserviceaccount.com

# Optional: enable the standalone admin SPA at /console
# ADMIN_SPA_ENABLED=true

# Optional: social OAuth providers
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
