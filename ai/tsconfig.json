{
  "compilerOptions": {
    "declaration": true,
    "isolatedModules": true,
    "lib": ["es2023"],
    "module": "nodenext",
    "noImplicitAny": false,
    "noImplicitReturns": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "skipLibCheck": true,
    "strict": true,
    "target": "es2023",
    "types": ["node"]
  },
  "exclude": [
    "node_modules",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.isolated.ts",
    "src/**/*.isolated.tsx",
    "src/tests"
  ],
  "include": ["src"]
}
