{
  "compilerOptions": {
    "customConditions": ["bun"],
    "declaration": true,
    "declarationMap": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "es2022",
    "types": ["bun", "node"]
  },
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.isolated.ts"],
  "include": ["src"]
}
