    "/announcements/import-release": {
      "post": {
        "description": "Idempotently create or update a release pack. Defaults to drafts; set publish=true to publish.",
        "operationId": "announcements_import-release",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "announcements": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "acknowledgementPolicy": {
                          "enum": [
                            "required",
                            "dismiss-only",
                          ],
                          "type": "string",
                        },
                        "audience": {
                          "nullable": true,
                        },
                        "audienceType": {
                          "enum": [
                            "staff",
                            "patient",
                            "all",
                          ],
                          "type": "string",
                        },
                        "body": {
                          "minLength": 1,
                          "type": "string",
                        },
                        "displayMode": {
                          "enum": [
                            "modal",
                            "banner",
                            "feed",
                          ],
                          "type": "string",
                        },
                        "expiresAt": {
                          "format": "date-time",
                          "type": "string",
                        },
                        "minBuildNumber": {
                          "exclusiveMinimum": true,
                          "minimum": 0,
                          "type": "integer",
                        },
                        "platforms": {
                          "items": {
                            "enum": [
                              "ios",
                              "android",
                              "web",
                            ],
                            "type": "string",
                          },
                          "minItems": 1,
                          "type": "array",
                        },
                        "primaryAction": {
                          "additionalProperties": false,
                          "properties": {
                            "label": {
                              "minLength": 1,
                              "type": "string",
                            },
                            "url": {
                              "format": "uri",
                              "type": "string",
                            },
                          },
                          "required": [
                            "label",
                            "url",
                          ],
                          "type": "object",
                        },
                        "priority": {
                          "type": "number",
                        },
                        "publishAt": {
                          "format": "date-time",
                          "type": "string",
                        },
                        "slug": {
                          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                          "type": "string",
                        },
                        "title": {
                          "minLength": 1,
                          "type": "string",
                        },
                      },
                      "required": [
                        "body",
                        "slug",
                        "title",
                      ],
                      "type": "object",
                    },
                    "maxItems": 100,
                    "minItems": 1,
                    "type": "array",
                  },
                  "defaults": {
                    "additionalProperties": false,
                    "properties": {
                      "acknowledgementPolicy": {
                        "enum": [
                          "required",
                          "dismiss-only",
                        ],
                        "type": "string",
                      },
                      "audience": {
                        "nullable": true,
                      },
                      "audienceType": {
                        "enum": [
                          "staff",
                          "patient",
                          "all",
                        ],
                        "type": "string",
                      },
                      "displayMode": {
                        "enum": [
                          "modal",
                          "banner",
                          "feed",
                        ],
                        "type": "string",
                      },
                      "expiresAt": {
                        "format": "date-time",
                        "type": "string",
                      },
                      "minBuildNumber": {
                        "exclusiveMinimum": true,
                        "minimum": 0,
                        "type": "integer",
                      },
                      "platforms": {
                        "items": {
                          "enum": [
                            "ios",
                            "android",
                            "web",
                          ],
                          "type": "string",
                        },
                        "minItems": 1,
                        "type": "array",
                      },
                      "priority": {
                        "type": "number",
                      },
                      "publishAt": {
                        "format": "date-time",
                        "type": "string",
                      },
                    },
                    "type": "object",
                  },
                  "publish": {
                    "default": false,
                    "type": "boolean",
                  },
                  "release": {
                    "additionalProperties": false,
                    "properties": {
                      "buildNumber": {
                        "exclusiveMinimum": true,
                        "minimum": 0,
                        "type": "integer",
                      },
                      "channel": {
                        "default": "production",
                        "minLength": 1,
                        "type": "string",
                      },
                      "product": {
                        "minLength": 1,
                        "type": "string",
                      },
                      "version": {
                        "minLength": 1,
                        "type": "string",
                      },
                    },
                    "required": [
                      "product",
                      "version",
                    ],
