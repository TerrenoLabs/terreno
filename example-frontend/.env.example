# Backend API URL — inlined into the web bundle at build time (required for production deploys)
EXPO_PUBLIC_API_URL=http://localhost:4000

# Local dev API port when auto-detecting from Expo hostUri (default 4000)
# EXPO_PUBLIC_DEV_API_PORT=4000

# SDK generation — backend OpenAPI spec URL
OPENAPI_URL=http://localhost:4000/openapi.json

# Better Auth on web: send a stored bearer token instead of the session cookie (default: cookie).
# Turn it on when the web app and the API are on different sites, where browsers block
# third-party cookies. The API must list the web origin in its Better Auth trusted origins.
# EXPO_PUBLIC_BETTER_AUTH_WEB_BEARER=true

# Dev and e2e only, with bearer mode on: show a "Continue with Mock OIDC" button that signs in
# through the local mock OIDC provider (e2e/helpers/mockOidcProvider.ts). The backend must set
# MOCK_OIDC_ISSUER and BETTER_AUTH_OAUTH_HANDOFF=true.
# EXPO_PUBLIC_MOCK_OIDC_SIGN_IN=true
