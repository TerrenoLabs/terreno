    "/todos/": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "_id",
            "schema": {
              "properties": {
                "$in": {
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
              },
              "type": "object",
            },
          },
          {
            "in": "query",
            "name": "completed",
            "schema": {
              "oneOf": [
                {
                  "default": false,
                  "description": "Whether the todo item has been completed",
                  "type": "boolean",
                },
                {
                  "properties": {
                    "$in": {
                      "items": {
                        "type": "boolean",
                      },
                      "type": "array",
                    },
                  },
                  "type": "object",
                },
              ],
            },
          },
          {
            "in": "query",
            "name": "ownerId",
            "schema": {
              "oneOf": [
                {
                  "description": "The user who owns this todo",
                  "type": "schemaobjectid",
                },
                {
                  "properties": {
                    "$in": {
                      "items": {
                        "type": "schemaobjectid",
                      },
                      "type": "array",
                    },
                  },
                  "type": "object",
                },
              ],
            },
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "number",
            },
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "number",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "properties": {
                          "_id": {
                            "description": "The document id (String so offline sync clients can mint ids)",
                            "type": "string",
                          },
                          "_syncPrevStream": {
                            "description": "The document's previous sync stream, set when a write moved it between scopes; null when the last write did not move it",
                            "type": "string",
                          },
                          "_syncSeq": {
                            "description": "Monotonic per-stream sequence stamped on every synced write",
                            "type": "number",
                          },
                          "completed": {
                            "description": "Whether the todo item has been completed",
                            "type": "boolean",
                          },
                          "created": {
                            "description": "When this document was created",
                            "format": "date-time",
                            "type": "string",
                          },
                          "deleted": {
                            "description": "Deleted objects are not returned in any find() or findOne() by default. Add {deleted: true} to find them.",
                            "type": "boolean",
                          },
                          "ownerId": {
                            "description": "The user who owns this todo",
                            "format": "objectid",
                            "type": "string",
                          },
                          "priority": {
                            "description": "Priority level of the todo",
                            "enum": [
                              "low",
                              "medium",
                              "high",
                            ],
                            "type": "string",
                          },
                          "tags": {
                            "description": "Free-form tags for categorization",
                            "items": {
                              "type": "string",
                            },
                            "type": "array",
