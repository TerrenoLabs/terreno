  "description": "React Native UI component library for iOS, Android, and web — part of Terreno, the batteries-included TypeScript framework for universal apps.",
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@testing-library/react-native": "catalog:",
    "@types/bun": "catalog:",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/lodash": "catalog:",
    "@types/luxon": "catalog:",
    "@types/mdurl": "^2.0.0",
    "@types/react": "catalog:",
    "expo-modules-core": "catalog:",
    "mdurl": "catalog:",
    "react": "catalog:",
    "react-test-renderer": "catalog:",
    "tsc-watch": "^7.1.1",
    "typedoc": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./dist/*": {
      "default": "./dist/*.js",
      "types": "./dist/*.d.ts"
    },
    "./*": {
      "default": "./dist/*.js",
      "types": "./dist/*.d.ts"
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*"
  },
  "files": [
    "LICENSE",
    "dist/**/*",
    "src/**/*",
    ".ai/**/*"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "name": "@terreno/ui",
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "^19.2.0",
    "react-native": "~0.86.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "prettier": {
    "arrowParens": "always",
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "es5",
    "useTabs": false
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "compile": "tsc",
    "compile:watch": "tsc -w",
    "dev": "tsc -w",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:unsafefix": "biome check --write --unsafe .",
    "local": "tsc-watch --onSuccess \"cp -a dist/* ../flourish/node_modules/@terreno/ui/dist\"",
    "performance:p0": "RUN_UI_P0_BENCHMARK=1 bun test --preload ./src/bunSetup.ts ./benchmarks/P0RenderPerformance.test.tsx",
    "performance:p0:openapi": "bun run compile && RUN_UI_P0_OPENAPI_BENCHMARK=1 bun test --preload ./src/bunSetup.ts ./benchmarks/P0OpenAPIPerformance.test.tsx",
    "performance:p1": "bun run compile && RUN_UI_P1_BENCHMARK=1 bun test --preload ./src/bunSetup.ts ./benchmarks/P1RenderPerformance.test.tsx",
    "performance:datatable-virtual": "bun run compile && RUN_UI_DATATABLE_VIRTUAL_BENCHMARK=1 bun test --preload ./src/bunSetup.ts ./benchmarks/DataTableVirtualizationPerformance.test.tsx",
    "performance:imports": "bun run compile && RUN_UI_IMPORT_BENCHMARK=1 bun test --preload ./src/bunSetup.ts ./benchmarks/RootImportBenchmark.test.tsx",
    "performance:p2:button": "bun run compile && RUN_UI_P2_BUTTON_BENCHMARK=1 bun test --preload ./src/bunSetup.ts ./benchmarks/P2ButtonPerformance.test.tsx",
    "performance:p2:responsive-box": "bun run compile && RUN_UI_P2_RESPONSIVE_BOX_BENCHMARK=1 bun test --preload ./src/bunSetup.ts ./benchmarks/P2ResponsiveBoxPerformance.test.tsx",
    "test": "TZ=America/New_York bun test --watch",
    "test:agent": "AGENT=1 TZ=America/New_York bun test --only-failures",
    "test:ci": "TZ=America/New_York bun test",
    "test:coverage": "TZ=America/New_York bun run ../scripts/check-coverage.ts",
    "types": "bun typedoc"
  },
  "version": "57.10.1",
  "bugs": {
    "url": "https://github.com/TerrenoLabs/terreno/issues"
  },
  "homepage": "https://github.com/TerrenoLabs/terreno#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/TerrenoLabs/terreno.git"
  },
  "keywords": [
    "react-native",
    "expo",
    "ui",
    "universal-apps",
    "terreno"
  ]
}
