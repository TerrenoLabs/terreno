              },
              "type": "object",
            },
          },
          {
            "in": "query",
            "name": "ownerId",
            "schema": {
              "oneOf": [
                {
                  "description": "The user these preferences belong to",
                  "type": "schemaobjectid",
                },
                {
                  "properties": {
                    "$in": {
                      "items": {
                        "type": "schemaobjectid",
                      },
                      "type": "array",
