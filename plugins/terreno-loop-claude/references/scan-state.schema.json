{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terreno.dev/schemas/scan-state.schema.json",
  "title": "Terreno scan campaign state",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "goal", "stage", "round", "attempt", "next"],
  "properties": {
    "v": {"const": 2},
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "statement", "metric", "baseline", "target"],
      "properties": {
        "slug": {"type": "string"},
        "statement": {"type": "string"},
        "charter": {"type": "string"},
        "metric": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "command", "unit", "direction"],
          "properties": {
            "name": {"type": "string"},
            "command": {"type": "string"},
            "unit": {"type": "string"},
            "direction": {"enum": ["up", "down"]},
            "protocol": {"type": "string"}
          }
        },
        "baseline": {"type": "number"},
        "target": {"type": "number"},
        "current": {"type": "number"},
        "horizon": {"type": "string"},
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {"enum": ["fixed", "codeowners", "blame", "round-robin", "none"]},
            "reviewers": {"type": "array", "items": {"type": "string"}},
            "assignees": {"type": "array", "items": {"type": "string"}},
            "teams": {"type": "array", "items": {"type": "string"}},
            "draft": {"type": "boolean"},
            "labels": {"type": "array", "items": {"type": "string"}},
            "wipLimit": {"type": "integer", "minimum": 1},
            "mergePolicy": {"enum": ["human", "agent-after-approval"]},
            "notify": {"type": "string"},
            "rotation": {"type": "integer", "minimum": 0}
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rounds": {"type": "integer", "minimum": 1},
            "slicesPerRound": {"type": "integer", "minimum": 1},
            "openPrs": {"type": "integer", "minimum": 1},
            "minStep": {"type": "number"}
          }
        }
      }
    },
    "stage": {"enum": ["aim", "sweep", "sift", "plot", "track"]},
    "round": {"type": "integer", "minimum": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "branch": {"type": "string"},
    "skills": {"type": "array", "items": {"type": "string"}},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "query", "matches", "why"],
        "properties": {
          "name": {"type": "string"},
          "query": {"type": "string"},
          "matches": {"type": "string"},
          "why": {"type": "string"},
          "exclude": {"type": "array", "items": {"type": "string"}},
          "hits": {"type": "integer", "minimum": 0}
        }
      }
    },
    "exclude": {"type": "array", "items": {"type": "string"}},
    "findings": {
      "type": "array",
      "items": {"$ref": "finding.schema.json"}
    },
    "slices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "findings", "status"],
        "properties": {
          "slug": {"type": "string"},
          "ip": {"type": "string"},
          "tasks": {"type": "string"},
          "findings": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["planned", "running", "merged", "abandoned"]},
          "branch": {"type": "string"},
          "pr": {"type": "string"},
          "reviewer": {"type": "string"},
          "assignee": {"type": "string"},
          "routedBy": {"enum": ["fixed", "codeowners", "blame", "round-robin", "none"]},
          "bucket": {
            "enum": ["unrouted", "answered", "broken", "bot-pending", "merged", "closed", "waiting"]
          },
          "answered": {"type": "array", "items": {"type": "string"}},
          "closedReason": {"type": "string"},
          "round": {"type": "integer", "minimum": 1}
        }
      }
    },
    "rounds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["round", "metricStart", "ev"],
        "properties": {
          "round": {"type": "integer", "minimum": 1},
          "metricStart": {"type": "number"},
          "metricEnd": {"type": "number"},
          "found": {"type": "integer", "minimum": 0},
          "kept": {"type": "integer", "minimum": 0},
          "planned": {"type": "integer", "minimum": 0},
          "fixed": {"type": "integer", "minimum": 0},
          "dismissed": {"type": "integer", "minimum": 0},
          "reopened": {"type": "integer", "minimum": 0},
          "slices": {"type": "array", "items": {"type": "string"}},
          "risks": {"type": "array", "items": {"type": "string"}},
          "ev": {"type": "string"}
        }
      }
    },
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lastTick": {"type": "string"},
        "interval": {"type": "integer", "minimum": 1},
        "ticks": {"type": "integer", "minimum": 0},
        "hostFailures": {"type": "integer", "minimum": 0},
        "overrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reviewers": {"type": "array", "items": {"type": "string"}},
            "assignee": {"type": "string"},
            "wipLimit": {"type": "integer", "minimum": 1},
            "rounds": {"type": "integer", "minimum": 1},
            "until": {"type": "string"},
            "tick": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "last": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "scan-result.schema.json"}
      ]
    },
    "tried": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "attempt", "why", "status", "ev"],
        "properties": {
          "stage": {"enum": ["aim", "sweep", "sift", "plot", "track"]},
          "attempt": {"type": "integer", "minimum": 1},
          "why": {"type": "string"},
          "status": {"enum": ["PASS", "FAIL", "BLOCKED", "PENDING"]},
          "ev": {"type": "string"}
        }
      }
    },
    "next": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "why", "human"],
      "properties": {
        "stage": {
          "type": ["string", "null"],
          "enum": ["aim", "sweep", "sift", "plot", "track", null]
        },
        "handoff": {
          "type": ["string", "null"],
          "enum": ["grow", "pick", null]
        },
        "why": {"type": "string"},
        "human": {"type": "boolean"}
      }
    }
  }
}
