{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": ["esnext"],
    "module": "preserve",
    "moduleDetection": "force",
    "noEmit": true,
    "paths": {
      "@api/*": ["./src/api/*"],
      "@models/*": ["./src/models/*"],
      "@scripts/*": ["./src/scripts/*"],
      "@services/*": ["./src/services/*"],
      "@tasks/*": ["./src/tasks/*"],
      "@test/*": ["./src/test/*"],
      "@tests/*": ["./src/tests/*"],
      "@types": ["./src/types/index.ts"],
      "@types/*": ["./src/types/*"],
      "@utils/*": ["./src/utils/*"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "esnext",
    "types": ["bun"],
    "verbatimModuleSyntax": true
  },
  "exclude": ["node_modules"],
  "include": ["src"]
}
