{
  "author": "Josh Gachnang",
  "bin": {
    "terreno-test-hygiene": "./dist/cli/testHygieneCli.js",
    "terreno-test-shard": "./dist/cli/testShardCli.js"
  },
  "bugs": {
    "url": "https://github.com/TerrenoLabs/terreno/issues"
  },
  "dependencies": {
    "@types/supertest": "catalog:",
    "express": "catalog:",
    "luxon": "catalog:",
    "mongodb-memory-server": "catalog:",
    "mongodb-memory-server-core": "^11.0.1",
    "mongodb-memory-server-global": "^11.0.1",
    "qs": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "winston": "catalog:"
  },
  "description": "Shared Bun test helpers, MongoDB preload utilities, and HTTP fixtures — part of Terreno, the batteries-included TypeScript framework for universal apps.",
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@reduxjs/toolkit": "catalog:",
    "@terreno/ui": "workspace:*",
    "@testing-library/react-native": "catalog:",
    "@types/bun": "catalog:",
    "@types/express": "catalog:",
    "@types/luxon": "catalog:",
    "@types/react": "catalog:",
    "mongoose": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-redux": "catalog:"
  },
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./expo/*": {
      "default": "./src/expo/*.ts",
      "types": "./dist/expo/*.d.ts"
    },
    "./preload/memoryMongo": "./src/preload/memoryMongo.ts"
  },
  "files": [
    "LICENSE",
    "CHANGELOG.md",
    "README.md",
    "dist/**/*",
    "src/**/*.ts",
    "!src/**/*.test.ts"
  ],
  "homepage": "https://github.com/TerrenoLabs/terreno#readme",
  "keywords": [
    "bun",
    "mongodb",
    "supertest",
    "terreno",
    "testing"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "name": "@terreno/test",
  "peerDependencies": {
    "@terreno/ui": "workspace:*",
    "@testing-library/react-native": "catalog:",
    "mongoose": "^8.0.0 || ^9.0.0",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-redux": "catalog:"
  },
  "peerDependenciesMeta": {
    "@terreno/ui": {
      "optional": true
    },
    "@testing-library/react-native": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-redux": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/TerrenoLabs/terreno.git"
  },
  "scripts": {
    "compile": "bun tsc",
    "compile:watch": "bun tsc -w",
    "dev": "bun tsc -w",
    "ensure-mongo-binary": "bun ./src/mongo/ensureMongoBinary.ts",
    "lint": "biome check ./src",
    "lint:fix": "biome check --write ./src",
    "test": "bun test",
    "test:agent": "AGENT=1 bun test --only-failures",
    "test:ci": "bun test",
    "test:coverage": "bun run ../scripts/check-coverage.ts"
  },
  "types": "dist/index.d.ts",
  "version": "57.19.2"
}
