{
  "author": "Josh Gachnang",
  "bugs": {
    "url": "https://github.com/TerrenoLabs/terreno/issues"
  },
  "dependencies": {
    "@google-cloud/storage": "catalog:",
    "@terreno/api": "workspace:*",
    "@terreno/jobs": "workspace:*",
    "express": "catalog:",
    "luxon": "catalog:",
    "multer": "catalog:"
  },
  "description": "Admin panel backend plugin for @terreno/api — part of Terreno, the batteries-included TypeScript framework for universal apps.",
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@terreno/test": "workspace:*",
    "@types/bun": "catalog:",
    "@types/express": "catalog:",
    "@types/luxon": "catalog:",
    "@types/multer": "catalog:",
    "@types/supertest": "catalog:",
    "passport-local-mongoose": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:"
  },
  "homepage": "https://github.com/TerrenoLabs/terreno#readme",
  "keywords": [
    "admin",
    "api",
    "express",
    "terreno"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "name": "@terreno/admin-backend",
  "peerDependencies": {
    "mongoose": "^8.0.0 || ^9.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/TerrenoLabs/terreno.git"
  },
  "scripts": {
    "compile": "node ../.github/scripts/compile-workspace-deps.js && bun tsc",
    "compile:watch": "bun tsc -w",
    "dev": "bun tsc -w",
    "lint": "biome check ./src ./e2e",
    "lint:fix": "biome check --write ./src ./e2e",
    "smoke": "bun e2e/smoke.ts",
    "test": "bun test --timeout=120000",
    "test:agent": "AGENT=1 bun test --only-failures --timeout=120000",
    "test:ci": "bun test --timeout=120000",
    "test:coverage": "bun run ../scripts/check-coverage.ts"
  },
  "types": "dist/index.d.ts",
  "version": "57.19.2"
}
