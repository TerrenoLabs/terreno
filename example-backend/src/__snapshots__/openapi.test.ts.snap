    "/announcements/": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "_id",
            "schema": {
              "properties": {
                "$in": {
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
              },
              "type": "object",
            },
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "oneOf": [
                {
                  "default": "draft",
                  "description": "Lifecycle status: draft, published, or archived",
                  "enum": [
                    "draft",
                    "published",
                    "archived",
                  ],
                  "type": "string",
                },
                {
                  "properties": {
                    "$in": {
                      "items": {
                        "type": "string",
                      },
                      "type": "array",
                    },
                  },
                  "type": "object",
                },
              ],
            },
          },
          {
            "in": "query",
            "name": "priority",
            "schema": {
              "oneOf": [
                {
                  "default": 0,
                  "description": "Higher priority announcements appear first in the modal queue",
                  "type": "number",
                },
                {
                  "properties": {
                    "$gt": {
                      "default": 0,
                      "description": "Higher priority announcements appear first in the modal queue",
                      "type": "number",
                    },
                    "$gte": {
                      "default": 0,
                      "description": "Higher priority announcements appear first in the modal queue",
                      "type": "number",
                    },
                    "$lt": {
                      "default": 0,
                      "description": "Higher priority announcements appear first in the modal queue",
                      "type": "number",
                    },
                    "$lte": {
                      "default": 0,
                      "description": "Higher priority announcements appear first in the modal queue",
                      "type": "number",
                    },
                  },
                  "type": "object",
                },
              ],
            },
          },
          {
            "in": "query",
            "name": "title",
            "schema": {
              "oneOf": [
                {
                  "description": "Announcement title shown in modal and changelog feed",
                  "type": "string",
                },
                {
                  "properties": {
                    "$in": {
                      "items": {
                        "type": "string",
                      },
                      "type": "array",
                    },
                  },
                  "type": "object",
                },
              ],
            },
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "number",
            },
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "number",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "properties": {
                          "_id": {
                            "type": "string",
                          },
                          "acknowledgementPolicy": {
                            "description": "Whether users must acknowledge (required) or may dismiss with an impression only (dismiss-only). Omitted values resolve from the plugin defaultAcknowledgementPolicy at read time.",
                            "enum": [
                              "required",
                              "dismiss-only",
                            ],
                            "type": "string",
                          },
                          "archivedAt": {
                            "description": "When the announcement was archived",
                            "format": "date-time",
                            "type": "string",
                          },
                          "audience": {
                            "description": "Opaque targeting metadata consumed by matchAudience callback",
                          },
                          "audienceType": {
                            "description": "First-class audience targeting: staff, patient, or all. Composed with matchAudience via matchAudienceByType.",
                            "enum": [
                              "staff",
                              "patient",
                              "all",
                            ],
                            "type": "string",
                          },
                          "body": {
                            "description": "Markdown body shown in the announcement modal",
                            "type": "string",
                          },
                          "created": {
                            "description": "When this document was created",
                            "format": "date-time",
                            "type": "string",
                          },
                          "deleted": {
                            "description": "Deleted objects are not returned in any find() or findOne() by default. Add {deleted: true} to find them.",
                            "type": "boolean",
                          },
                          "displayMode": {
                            "description": "Where the announcement appears: blocking modal, non-blocking banner, or feed-only changelog entry",
                            "enum": [
                              "modal",
                              "banner",
                              "feed",
                            ],
                            "type": "string",
                          },
                          "expiresAt": {
                            "description": "Optional expiry — hidden from pending/feed after this time",
                            "format": "date-time",
                            "type": "string",
                          },
                          "minBuildNumber": {
                            "description": "Optional minimum client build number. Hidden from pending, feed, and help when query version is a finite integer below this value",
                            "type": "number",
                          },
                          "platforms": {
                            "description": "Platforms that should receive this announcement",
                            "items": {
                              "enum": [
                                "ios",
                                "android",
                                "web",
                              ],
                              "type": "string",
                            },
                            "type": "array",
                          },
                          "primaryAction": {
                            "properties": {
                              "label": {
                                "description": "Button label for optional primary action",
                                "type": "string",
                              },
                              "url": {
                                "description": "Deep link or external URL opened by the primary action button",
                                "type": "string",
                              },
                            },
                            "type": "object",
                          },
                          "priority": {
                            "description": "Higher priority announcements appear first in the modal queue",
                            "type": "number",
                          },
                          "publishAt": {
                            "description": "Optional scheduled publish time — hidden until this instant",
                            "format": "date-time",
                            "type": "string",
                          },
                          "publishedAt": {
                            "description": "When the announcement was first published",
                            "format": "date-time",
                            "type": "string",
                          },
                          "release": {
                            "properties": {
                              "buildNumber": {
