{
  "author": "Josh Gachnang",
  "bugs": {
    "url": "https://github.com/TerrenoLabs/terreno/issues"
  },
  "dependencies": {
    "express": "catalog:",
    "luxon": "catalog:",
    "qs": "catalog:",
    "winston": "catalog:"
  },
  "description": "Shared Bun test helpers, MongoDB preload utilities, and HTTP fixtures — part of Terreno, the batteries-included TypeScript framework for universal apps.",
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/bun": "catalog:",
    "@types/express": "catalog:",
    "@types/luxon": "catalog:",
    "@types/supertest": "catalog:",
    "mongodb-memory-server": "catalog:",
    "mongodb-memory-server-core": "^11.3.0",
    "mongodb-memory-server-global": "^11.3.0",
    "mongoose": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./preload/memoryMongo": "./src/preload/memoryMongo.ts"
  },
  "homepage": "https://github.com/TerrenoLabs/terreno#readme",
  "keywords": [
    "bun",
    "mongodb",
    "supertest",
    "terreno",
    "testing"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "name": "@terreno/test",
  "peerDependencies": {
    "mongoose": "^8.0.0 || ^9.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/TerrenoLabs/terreno.git"
  },
  "scripts": {
    "compile": "bun tsc",
    "compile:watch": "bun tsc -w",
    "dev": "bun tsc -w",
    "ensure-mongo-binary": "bun ./src/mongo/ensureMongoBinary.ts",
    "lint": "biome check ./src",
    "lint:fix": "biome check --write ./src",
    "test": "bun test",
    "test:agent": "AGENT=1 bun test --only-failures",
    "test:ci": "bun test",
    "test:coverage": "bun run ../scripts/check-coverage.ts"
  },
  "types": "dist/index.d.ts",
  "version": "57.10.1"
}
