    "/mcp/service-tokens": {
      "get": {
        "description": "Lists MCP service tokens owned by the signed-in user. Never includes plaintext or tokenHash.",
        "operationId": "listMcpServiceTokens",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "type": "number",
            },
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
