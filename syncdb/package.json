    "@terreno/ui": "workspace:*",
    "better-auth": "catalog:",
    "expo-constants": "*",
    "expo-network": "catalog:",
    "expo-secure-store": "catalog:",
    "expo-sqlite": "*",
    "react": "catalog:",
    "react-native": "catalog:"
  },
