{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terreno.dev/schemas/scan-result.schema.json",
  "title": "Terreno scan stage result",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "stage", "status", "next", "action"],
  "properties": {
    "v": {"const": 2},
    "stage": {"enum": ["aim", "sweep", "sift", "plot", "track"]},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED", "PENDING"]},
    "goal": {"type": "string"},
    "round": {"type": "integer", "minimum": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "branch": {"type": "string"},
    "sha": {"type": "string"},
    "pr": {"type": "string"},
    "skills": {"type": "array", "items": {"type": "string"}},
    "rules": {"type": "array", "items": {"type": "string"}},
    "shards": {"type": "integer", "minimum": 0},
    "found": {"type": "integer", "minimum": 0},
    "kept": {"type": "integer", "minimum": 0},
    "closed": {"type": "integer", "minimum": 0},
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "ev"],
      "properties": {
        "value": {"type": "number"},
        "unit": {"type": "string"},
        "delta": {"type": "number"},
        "ev": {"type": "string"}
      }
    },
    "done": {"type": "array", "items": {"type": "string"}},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "slices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "findings", "status"],
        "properties": {
          "slug": {"type": "string"},
          "ip": {"type": "string"},
          "tasks": {"type": "string"},
          "findings": {"type": "array", "items": {"type": "string"}},
          "status": {"enum": ["planned", "running", "merged", "abandoned"]},
          "pr": {"type": "string"}
        }
      }
    },
    "prs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pr", "bucket"],
        "properties": {
          "pr": {"type": "string"},
          "bucket": {
            "enum": ["unrouted", "answered", "broken", "bot-pending", "merged", "closed", "waiting"]
          },
          "who": {"type": "string"},
          "slice": {"type": "string"}
        }
      }
    },
    "fail": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["need", "want", "got", "ev"],
        "properties": {
          "need": {"type": "string"},
          "sev": {"enum": ["blocking", "non_blocking"]},
          "want": {"type": "string"},
          "got": {"type": "string"},
          "ev": {"type": "string"}
        }
      }
    },
    "block": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "why"],
        "properties": {
          "kind": {"enum": ["human", "environment", "access", "external"]},
          "why": {"type": "string"},
          "ev": {"type": "string"}
        }
      }
    },
    "ask": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["q", "rec"],
        "properties": {
          "q": {"type": "string"},
          "opts": {"type": "array", "items": {"type": "string"}},
          "rec": {"type": "string"}
        }
      }
    },
    "handoff": {
      "type": ["string", "null"],
      "enum": ["grow", "pick", null]
    },
    "next": {
      "type": ["string", "null"],
      "enum": ["aim", "sweep", "sift", "plot", "track", null]
    },
    "action": {"type": "string"},
    "wait": {"type": "integer", "minimum": 1}
  }
}
