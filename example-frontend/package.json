{
  "dependencies": {
    "@better-auth/expo": "^1.6.25",
    "@expo/vector-icons": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "@openfeature/react-sdk": "catalog:",
    "@openfeature/web-sdk": "catalog:",
    "@react-native-async-storage/async-storage": "catalog:",
    "@sentry/react": "catalog:",
    "@shopify/flash-list": "catalog:",
    "@stripe/stripe-react-native": "catalog:",
    "@terreno/blocks": "workspace:*",
    "@terreno/syncdb": "workspace:*",
    "@terreno/ui": "workspace:*",
    "better-auth": "catalog:",
    "expo": "catalog:",
    "expo-build-properties": "catalog:",
    "expo-clipboard": "catalog:",
    "expo-constants": "catalog:",
    "expo-crypto": "catalog:",
    "expo-dev-client": "catalog:",
    "expo-device": "catalog:",
    "expo-font": "catalog:",
    "expo-linking": "catalog:",
    "expo-local-authentication": "catalog:",
    "expo-network": "catalog:",
    "expo-notifications": "catalog:",
    "expo-print": "catalog:",
    "expo-router": "catalog:",
    "expo-secure-store": "catalog:",
    "expo-sharing": "catalog:",
    "expo-splash-screen": "catalog:",
    "expo-sqlite": "catalog:",
    "expo-system-ui": "catalog:",
    "expo-updates": "catalog:",
    "luxon": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-gesture-handler": "catalog:",
    "react-native-purchases": "catalog:",
    "react-native-purchases-ui": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:",
    "react-native-web": "catalog:",
    "react-native-webview": "catalog:",
    "react-native-worklets": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@playwright/test": "catalog:",
    "@terreno/test": "workspace:*",
    "@types/luxon": "catalog:",
    "@types/react": "catalog:",
    "babel-preset-expo": "catalog:",
    "expo-mcp": "^0.2.4",
    "mongodb": "catalog:",
    "react-test-renderer": "catalog:",
    "typescript": "catalog:"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@react-native-community/blur"
        ]
      }
    }
  },
  "main": "index.js",
  "name": "@terreno/example-frontend",
  "private": true,
  "scripts": {
    "android": "bun expo start --android --port 8082",
    "api-sdk": "bun ../syncdb/src/codegen/cli.ts --schema ${OPENAPI_URL:-http://localhost:4000/openapi.json} --api-out ./store/apiSdk.ts --config ./syncdb-codegen.json",
    "build:vercel": "bun scripts/vercelBuild.ts",
    "doctor": "bunx expo-doctor",
    "eas-build-post-install": "cd .. && bun run compile && bun run --filter '@terreno/ui' types",
    "export": "bun expo export --platform web",
    "ios": "EXPO_UNSTABLE_MCP_SERVER=1 bun expo start --ios --port 8082",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:unsafefix": "biome check --write --unsafe .",
    "sdk": "bun run api-sdk",
    "smoke:deployed": "playwright test --config playwright.smoke.config.ts",
    "start": "EXPO_UNSTABLE_MCP_SERVER=1 bun expo start --port 8082",
    "sync-sdk": "bun ../syncdb/src/codegen/cli.ts --schema ${OPENAPI_URL:-http://localhost:4000/openapi.json} --out ./store/syncDbSdk.ts --collections todos,notifications,notification-preferences,gpt/histories,mcp/service-tokens --config ./syncdb-codegen.json",
    "test": "bun test ./**/*.test.ts ./**/*.test.tsx",
    "test:agent": "AGENT=1 bun test --only-failures ./**/*.test.ts ./**/*.test.tsx",
    "test:ci": "bun test ./**/*.test.ts ./**/*.test.tsx",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "web": "NODE_OPTIONS=--max-old-space-size=8192 bun expo start --web --port 8082"
  },
  "version": "1.0.0"
}
