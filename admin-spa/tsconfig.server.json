{
  "compilerOptions": {
    "declaration": true,
    "isolatedModules": true,
    "lib": ["es2023"],
    "module": "nodenext",
    "noImplicitReturns": true,
    "outDir": "./src/dist",
    "rootDir": "./src",
    "skipLibCheck": true,
    "strict": true,
    "target": "es2023",
    "types": ["node"]
  },
  "exclude": ["node_modules", "src/dist", "src/**/*.test.ts"],
  "include": ["src/index.ts", "src/serve.ts", "src/appConfig.ts", "src/serverContext.ts", "src/routesManifest.ts", "src/gate.ts", "src/returnTo.ts"]
}
