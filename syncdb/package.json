    "@types/bun": "catalog:",
    "@types/luxon": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "better-auth": "catalog:",
    "chai": "catalog:",
    "expo-constants": "catalog:",
    "expo-secure-store": "catalog:",
    "expo-sqlite": "catalog:",
    "fake-indexeddb": "^6.0.0",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-test-renderer": "catalog:",
    "socket.io": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./api": {
      "default": "./dist/api/client.js",
      "types": "./dist/api/client.d.ts"
    },
    "./app": {
      "default": "./dist/app/app.js",
      "types": "./dist/app/app.d.ts"
    },
    "./auth": {
      "default": "./dist/auth/auth.js",
      "types": "./dist/auth/auth.d.ts"
    },
    "./buildNumber": {
      "default": "./dist/buildNumber.js",
      "types": "./dist/buildNumber.d.ts"
    },
    "./codegen": {
      "bun": "./src/codegen/generate.ts",
      "default": "./dist/codegen/generate.js",
      "types": "./dist/codegen/generate.d.ts"
    },
    "./config": {
      "default": "./dist/config/baseUrl.js",
      "types": "./dist/config/baseUrl.d.ts"
    },
    "./devConsoleLogger": {
      "default": "./dist/devConsoleLogger.js",
      "types": "./dist/devConsoleLogger.d.ts"
    },
    "./flags": {
      "default": "./dist/flags/useFeatureFlags.js",
      "types": "./dist/flags/useFeatureFlags.d.ts"
    },
    "./react": {
      "default": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./testing": {
      "default": "./dist/testing/index.js",
      "types": "./dist/testing/index.d.ts"
    }
  },
  "files": [
    "CHANGELOG.md",
    "dist/**/*",
    "src/**/*"
  ],
  "homepage": "https://github.com/TerrenoLabs/terreno#readme",
  "keywords": [
    "local-first",
    "tinybase",
    "sync",
    "offline",
    "terreno"
  ],
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "name": "@terreno/syncdb",
  "peerDependencies": {
    "@better-auth/expo": "^1.6.25",
    "@better-auth/passkey": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
